{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaTeX Viewer",
  "version": "0.9.2",
  "identifier": "ar.com.chyps.latexviewer",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "LaTeX Viewer", "width": 1400, "height": 900, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CHYPS",
    "shortDescription": "Editor de proyectos LaTeX grandes con compilación incremental",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
